# Ixon Cloud login (required)
IXON_EMAIL=your@email.com

# Ixon password (optional)
# If left empty, the program asks for it in the terminal when it logs in (about once an hour)
IXON_PASS=

# InfluxDB API token (required)
# To get a token: InfluxDB sidebar -> Load Data -> API Tokens -> Generate API Token
API_TOKEN=
